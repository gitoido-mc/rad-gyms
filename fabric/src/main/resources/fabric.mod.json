{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Rad Gyms",
  "description": "Adds roguelike gyms in Cobblemon. RCT Api based mod.",
  "authors": [
    "Gitoido <corpa@gito.lol>"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/gitoido-mc/rad-gyms"
  },
  "license": "GPL-3.0-only",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "lol.gito.radgyms.fabric.FabricBootstrap",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "lol.gito.radgyms.fabric.client.RadGymsFabricClient::initialize",
        "adapter": "kotlin"
      }
    ],
    "fabric-datagen": [
      {
        "value": "lol.gito.radgyms.fabric.datagen.RadGymsDataGenerator",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "${mod_id}.fabric.mixins.json",
    "${mod_id}.mixins.json",
    {
      "config": "${mod_id}.client.mixins.json",
      "environment": "client"
    }
  ],
  "accessWidener": "${mod_id}.accesswidener",
  "depends": {
    "java": ">=21",
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric": "*",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "architectury": ">=${architectury_version}",
    "rctapi": ">=${rctapi_min_version}",
    "cobblemon": ">=${cobblemon_version} <1.9.0"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "${mr_id}",
      "curseforge": "${cf_id}"
    }
  }
}
